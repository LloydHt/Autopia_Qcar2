<?xml version="1.0" ?>
<sdf version="1.8"> <world name="autopia_world">

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <background>0.4 0.6 0.8 1.0</background>
      <sky>
        <clouds>
          <speed>12</speed> </clouds>
      </sky>
    </scene>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://autopia_ground</uri>
      <pose>0 0 0.1 0 0 0</pose>
    </include>

    <include>
      <name>maison_1</name>
      <uri>model://house_1</uri> <pose>-2.5 2.5 0.1 0 0 0</pose> 
    </include>

    <include>
      <name>maison_2</name>
      <uri>model://house_1</uri>
      <pose>2.5 2.5 0.1 0 0 1.57</pose> 
    </include>

    <include>
      <name>maison_3</name>
      <uri>model://house_1</uri>
      <pose>-2.5 -2.5 0.1 0 0 3.14</pose> 
    </include>

    <include>
      <name>maison_4</name>
      <uri>model://house_1</uri>
      <pose>2.5 -2.5 0.1 0 0 -1.57</pose> 
    </include>

    <include>
      <name>arbre_centre</name>
      <uri>model://pine_tree</uri> 
      <pose>0 0 0.1 0 0 0</pose> 
    </include>

      <include>
        <name>stop_sign_top</name>
        <uri>model://stop_sign</uri>
        <pose>-0.8 4.2 0.1 0 0 1.57</pose>
      </include>

      <include>
        <name>stop_sign_right</name>
        <uri>model://stop_sign</uri>
        <pose>4.2 0.8 0.1 0 0 0</pose>
      </include>

      <include>
        <name>stop_sign_bottom</name>
        <uri>model://stop_sign</uri>
        <pose>0.8 -4.2 0.1 0 0 -1.57</pose>
      </include>

      <include>
        <name>stop_sign_left</name>
        <uri>model://stop_sign</uri>
        <pose>-4.2 -0.8 0.1 0 0 -3.14</pose>
      </include>

      <include>
        <name>stop_sign_top_outer</name>
        <uri>model://stop_sign</uri>
        <pose>0.8 5.8 0.1 0 0 -1.57</pose> 
      </include>

      <include>
        <name>stop_sign_right_outer</name>
        <uri>model://stop_sign</uri>
        <pose>5.8 -0.8 0.1 0 0 -3.14</pose> 
      </include>

      <include>
        <name>stop_sign_bottom_outer</name>
        <uri>model://stop_sign</uri>
        <pose>-0.8 -5.8 0.1 0 0 1.57</pose> 
      </include>

      <include>
        <name>stop_sign_left_outer</name>
        <uri>model://stop_sign</uri>
        <pose>-5.8 0.8 0.1 0 0 0</pose> 
      </include>
          

  </world>
</sdf>