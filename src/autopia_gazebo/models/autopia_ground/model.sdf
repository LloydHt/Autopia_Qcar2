<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="autopia_ground">
    <static>true</static>
    <link name="link">
      
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size> </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu> <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <cast_shadows>false</cast_shadows> <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>20 20</size> </plane>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/autopia_ground.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>