    <!-- =================================================== -->
    <!-- 4. CONTROLEUR ROS2 (Pour le faire traverser)        -->
    <!-- =================================================== -->
    <plugin name="anymal_controller" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/anymal_test</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <publish_odom>false</publish_odom>
    </plugin>
  </model>
</sdf>