<?xml version="1.0" ?>
<robot name="qcar2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="Black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>
    <material name="Blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
    </material>
    <material name="Green">
        <color rgba="0.0 0.8 0.0 1.0"/>
    </material>
    <material name="DarkGreen">
        <color rgba="0.0 0.2 0.0 1.0"/>
    </material>
    <material name="Grey">
        <color rgba="0.25 0.25 0.25 1.0"/>
    </material>
    <material name="DarkGrey">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    <material name="Orange">
        <color rgba="1.0 0.423 0.0392 1.0"/>
    </material>
    <material name="Brown">
        <color rgba="0.8706 0.818 0.765 1.0"/>
    </material>
    <material name="Red">
        <color rgba="0.8 0.0 0.0 1.0"/>
    </material>
    <material name="White">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
    <material name="Cyan">
        <color rgba="0 0.8 0.8 .8"/>
    </material>

  <link name="base_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCar2Body.stl" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="DarkGrey"/>
        </visual>
        <collision name="collision_center">
            <origin xyz="0.000 0 .053" rpy="0 0 0"/>
            <geometry>
                <box size=".155 .15 .08"/>
            </geometry>
        </collision>
        <collision name="collision_front">
            <origin xyz="0.194 0 .083" rpy="0 0 0"/>
            <geometry>
                <box size=".03 .15 .115"/>
            </geometry>
        </collision>
        <collision name="collision_back">
            <origin xyz="-0.183 0 .083" rpy="0 0 0"/>
            <geometry>
                <box size=".037 .15 .115"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="3.275"/>
            <inertia ixx="0.01235" ixy="0" ixz="0" iyy="0.0292" iyz="0" izz="0.03223"/>
        </inertial>
    </link>

  <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar"/>
        <origin rpy="0 0 0" xyz="-0.0139 0 .194"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="lidar">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 -0.01"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCar2Lidar.stl" scale="0.1 0.1 0.1"/>
            </geometry>
            <material name="Black"/>
        </visual>
    </link>

    <joint name="realsenseRGB_joint" type="fixed">
        <parent link="base_link"/>
        <child link="realsenseRGB"/>
        <origin rpy="-1.5708 0 0" xyz="0.095 0.034 0.176"/>
    </joint>
    <link name="realsenseRGB"/>

    <joint name="realsenseDepth_joint" type="fixed">
        <parent link="base_link"/>
        <child link="realsenseDepth"/>
        <origin rpy="-1.5708 0 -1.5708" xyz="0.095 -0.003 0.176"/>
    </joint>
    <link name="realsenseDepth"/>

    <joint name="csi_front_joint" type="fixed">
        <parent link="base_link"/>
        <child link="csi_front"/>
        <origin rpy="-1.5708 0 -1.5708" xyz="0.198 0 0.1095"/>
    </joint>
    <link name="csi_front"/>

    <joint name="csi_back_joint" type="fixed">
        <parent link="base_link"/>
        <child link="csi_back"/>
        <origin rpy="-1.5708 0 1.5708" xyz="-0.165 -0.0005 0.1095"/>
    </joint>
    <link name="csi_back"/>

    <joint name="csi_right_joint" type="fixed">
        <parent link="base_link"/>
        <child link="csi_right"/>
        <origin rpy="-1.5708 0 3.14159" xyz="0.0155 -0.072 0.1095"/>
    </joint>
    <link name="csi_right"/>

    <joint name="csi_left_joint" type="fixed">
        <parent link="base_link"/>
        <child link="csi_left"/>
        <origin rpy="-1.5708 0 0" xyz="0.0155 0.051 0.1095"/>
    </joint>
    <link name="csi_left"/>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu"/>
        <origin rpy="0 0 0" xyz="0.0119 0 0.0896"/>
    </joint>
    <link name="imu"/>

  <joint name="hub_frontLeft_joint" type="revolute">
        <parent link="base_link"/>
        <child link="hub_frontLeft"/>
        <origin rpy="0 0 0" xyz="0.12960 0.05590 0.03338"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5236" upper="0.5236" effort="300" velocity="2"/>
    </joint>
    <link name="hub_frontLeft">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarSteeringHubL.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="wheel_frontLeft_joint" type="continuous">
        <parent link="hub_frontLeft"/>
        <child link="wheel_frontLeft"/>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_frontLeft">
        <visual>
            <origin rpy="-1.5708 0 3.14159" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarWheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.022" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

  <joint name="hub_frontRight_joint"  type="revolute">
        <parent link="base_link"/>
        <child link="hub_frontRight"/>
        <origin rpy="0 0 0" xyz="0.12960 -0.05590 0.03338"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.5236" upper="0.5236" effort="300" velocity="2"/>
    </joint>
    <link name="hub_frontRight">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarSteeringHubR.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>
    
    <joint name="wheel_frontRight_joint" type="continuous">
        <parent link="hub_frontRight"/>
        <child link="wheel_frontRight"/>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_frontRight">
        <visual>
            <origin rpy="1.5708 0 3.14159" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarWheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.022" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

  <joint name="wheel_rearLeft_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rearLeft"/>
        <origin rpy="-1.5708 0 0" xyz="-0.12765 0.05610 0.03338"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_rearLeft">
        <visual>
            <origin rpy="-1.5708 0 3.14159" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarWheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.022" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

  <joint name="wheel_rearRight_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_rearRight"/>
        <origin rpy="-1.5708 0 0" xyz="-0.12765 -0.05610 0.03338"/>
        <axis xyz="0 0 1"/>
    </joint>
    <link name="wheel_rearRight">
        <visual>
            <origin rpy="1.5708 0 3.14159" xyz="0 0 0"/>    
            <geometry>
                <mesh filename="package://qcar2/meshes/QCarWheel.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.022" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.033" length="0.025"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

  <gazebo reference="base_link">
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="lidar">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="hub_frontLeft">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="hub_frontRight">
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="wheel_frontLeft">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_frontRight">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_rearLeft">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="wheel_rearRight">
        <material>Gazebo/Black</material>
    </gazebo>

  <gazebo>
        <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
            <left_joint>wheel_rearLeft_joint</left_joint>
            <right_joint>wheel_rearRight_joint</right_joint>
            <left_steering_joint>hub_frontLeft_joint</left_steering_joint>
            <right_steering_joint>hub_frontRight_joint</right_steering_joint>
            <wheel_base>0.25725</wheel_base>
            <wheel_separation>0.1122</wheel_separation>
            <wheel_radius>0.033</wheel_radius>
            <topic>/cmd_vel</topic>
            <odom_publish_frequency>50</odom_publish_frequency>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

    <gazebo reference="lidar">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <gz_frame_id>lidar</gz_frame_id>
            <lidar> <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>4.0</max>
                </range>
            </lidar>
        </sensor>
    </gazebo>

    <gazebo reference="imu">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>/model/qcar2/imu</topic>
            <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="realsenseRGB">
        <sensor name="realsense_rgb" type="camera">
            <always_on>true</always_on>
            <visualize>true</visualize> 
            <update_rate>30</update_rate>
            <topic>camera/color/image_raw</topic>
            <gz_frame_id>realsenseRGB</gz_frame_id>
            <camera>
                <camera_info_topic>camera/color/camera_info</camera_info_topic>
                <horizontal_fov>1.211</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="realsenseDepth">
        <sensor name="realsense_depth" type="depth_camera">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>30</update_rate>
            <topic>camera/depth/image_raw</topic>
            <gz_frame_id>realsenseDepth</gz_frame_id>
            <camera>
                <camera_info_topic>camera/depth/camera_info</camera_info_topic>
                <horizontal_fov>1.211</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>